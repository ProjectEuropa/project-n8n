FROM rust:1.85-bookworm AS builder

ARG OPENFANG_SOURCE_REPO=https://github.com/RightNow-AI/openfang
ARG OPENFANG_SOURCE_REF=v0.5.6
ARG OPENFANG_SOURCE_COMMIT=

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    git \
    pkg-config \
    perl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY upstream-overrides/ /tmp/upstream-overrides/
COPY upstream-src/ /tmp/upstream-src/

RUN if [ -f /tmp/upstream-src/Cargo.toml ]; then \
      cp -R /tmp/upstream-src /src/openfang; \
    else \
      git clone --depth 1 --branch "${OPENFANG_SOURCE_REF}" "${OPENFANG_SOURCE_REPO}" /src/openfang; \
      if [ -n "${OPENFANG_SOURCE_COMMIT}" ]; then \
        test "$(git -C /src/openfang rev-parse HEAD)" = "${OPENFANG_SOURCE_COMMIT}"; \
      fi; \
    fi

WORKDIR /src/openfang

ENV CARGO_BUILD_JOBS=1

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/openfang/target \
    perl -0pi -e 's/\[profile\.release\]\nlto = true\ncodegen-units = 1/[profile.release]\nlto = false\ncodegen-units = 16/' /src/openfang/Cargo.toml && \
    perl -0pi -e 's/currentAgent \? currentAgent\.model_provider \+ \x27:\x27 \+ currentAgent\.model_name : \x27\x27/currentAgent ? formatProviderModel(currentAgent.model_provider, currentAgent.model_name) : \x27\x27/' /src/openfang/crates/openfang-api/static/index_body.html && \
    perl -0pi -e 's/a\.name \+ \x27 \(\x27 \+ \(a\.model_provider \|\| \x27unknown\x27\) \+ \x27:\x27 \+ \(a\.model_name \|\| \x27unknown\x27\) \+ \x27\)\x27/a.name + \x27 (\x27 + formatProviderModel(a.model_provider || \x27unknown\x27, a.model_name || \x27unknown\x27) + \x27)\x27/' /src/openfang/crates/openfang-api/static/index_body.html && \
    grep -Fq 'formatProviderModel(currentAgent.model_provider, currentAgent.model_name)' /src/openfang/crates/openfang-api/static/index_body.html && \
    grep -Fq "formatProviderModel(a.model_provider || 'unknown', a.model_name || 'unknown')" /src/openfang/crates/openfang-api/static/index_body.html && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/app.js /src/openfang/crates/openfang-api/static/js/app.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/chat.js /src/openfang/crates/openfang-api/static/js/pages/chat.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/agents.js /src/openfang/crates/openfang-api/static/js/pages/agents.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/wizard.js /src/openfang/crates/openfang-api/static/js/pages/wizard.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/settings.js /src/openfang/crates/openfang-api/static/js/pages/settings.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/overview.js /src/openfang/crates/openfang-api/static/js/pages/overview.js && \
    cp /tmp/upstream-overrides/crates/openfang-api/static/js/pages/runtime.js /src/openfang/crates/openfang-api/static/js/pages/runtime.js && \
    cargo build --release -p openfang-cli --bin openfang && \
    install -Dm755 target/release/openfang /out/openfang

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    socat \
    python3 \
    python3-cryptography \
    && rm -rf /var/lib/apt/lists/*

COPY gcp-token.py /usr/local/bin/gcp-token.py
COPY fake-gcloud.sh /usr/local/bin/gcloud
RUN chmod +x /usr/local/bin/gcp-token.py /usr/local/bin/gcloud

RUN groupadd -r -g 1000 openfang && useradd -m -r -u 1000 -g openfang openfang

COPY --from=builder /out/openfang /usr/local/bin/openfang

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && mkdir -p /data \
    && chown -R openfang:openfang /usr/local/bin/openfang /entrypoint.sh /usr/local/bin/gcp-token.py /usr/local/bin/gcloud /data

USER openfang
ENV HOME=/home/openfang

EXPOSE 50051
VOLUME /data
ENV OPENFANG_HOME=/data
ENTRYPOINT ["/entrypoint.sh"]
