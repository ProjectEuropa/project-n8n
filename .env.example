# OpenFang + Caddy 環境変数設定
# このファイルを .env にコピーして、値を設定してください
# cp .env.example .env

# ドメイン設定
DOMAIN_NAME=example.com
SUBDOMAIN=ai

# SSL証明書用メールアドレス（Let's Encrypt通知用）
SSL_EMAIL=your-email@example.com

# 信頼できるプロキシのIP（オプション）
# 前段にCloudflareやNginx、ALB等のリバースプロキシがある場合、そのIPレンジを指定します（カンマ区切り不可、スペース区切り）
# 空の場合はCaddyfileのデフォルトとしてCloudflareの公式IPレンジが適用されます
TRUSTED_PROXIES=

# IP制限（オプション）
# 空のままにすると、IP制限は無効になります
# 例: ALLOWED_IPS=203.0.113.10 198.51.100.0/24
ALLOWED_IPS=

# Basic認証設定（オプション）
# 空のままにすると、Basic認証は無効になります
# ⚠️ scripts/setup-vps.sh を使うと対話形式でハッシュが自動生成されます
# ⚠️ 平文パスワードは .env に保存しないでください
BASIC_AUTH_USER=
# パスワードハッシュ（scripts/setup-vps.sh で自動生成、または手動: docker run --rm -i caddy:2.8.4 caddy hash-password）
BASIC_AUTH_PASSWORD_HASH=

# GCP設定（Vertex AI）
GCP_PROJECT_ID=your-gcp-project-id
# サービスアカウントキーファイルのパス
# dist/vps をそのまま配置する場合は ./credentials/adc.json のままで使えます
GCP_CREDENTIALS_PATH=./credentials/adc.json
# Vertex AI リージョン（東京）
VERTEX_AI_LOCATION=asia-northeast1

# OpenFang バイナリの SHA-256
# 対象バージョン / アーキテクチャの GitHub Releases にある値を設定してください
OPENFANG_SHA256_AMD64=
OPENFANG_SHA256_ARM64=

# OpenFang ビルド方法
# 既定は GitHub Releases の事前ビルド済みバイナリです
# patched UI が必要なときだけ compose.patched.yml を重ねて source build します
# OPENFANG_SOURCE_REPO=https://github.com/your-org/openfang
# OPENFANG_SOURCE_REF=your-branch-or-tag

# ボリューム名（通常は変更不要）
OPENFANG_DATA_VOLUME=openfang_data
CADDY_DATA_VOLUME=caddy_data
CADDY_CONFIG_VOLUME=caddy_config
