# OpenClaw + Caddy 環境変数設定
# このファイルを .env にコピーして、値を設定してください
# cp .env.example .env

# ドメイン設定
DOMAIN_NAME=example.com
SUBDOMAIN=ai

# SSL証明書用メールアドレス（Let's Encrypt通知用）
SSL_EMAIL=your-email@example.com

# 信頼できるプロキシのIP（オプション）
# 前段にCloudflareやNginx、ALB等のリバースプロキシがある場合、そのIPレンジを指定します（カンマ区切り不可、スペース区切り）
# 空の場合はCaddyfileのデフォルトとしてCloudflareの公式IPレンジが適用されます
TRUSTED_PROXIES=

# IP制限（オプション）
# 空のままにすると、IP制限は無効になります
# 例: ALLOWED_IPS=203.0.113.10 198.51.100.0/24
ALLOWED_IPS=

# Basic認証設定（オプション）
# 空のままにすると、Basic認証は無効になります
# ⚠️ setup-openclaw.sh を使うと対話形式でハッシュが自動生成されます
# ⚠️ 平文パスワードは .env に保存しないでください
BASIC_AUTH_USER=
# パスワードハッシュ（setup-openclaw.shで自動生成、または手動: docker run --rm -i caddy:2.8.4 caddy hash-password）
BASIC_AUTH_PASSWORD_HASH=

# GCP設定（Vertex AI）
GCP_PROJECT_ID=your-gcp-project-id
# サービスアカウントキーファイルのパス（ホスト側の絶対パス）
# Phase 1: サービスアカウントキー方式
# Phase 2 (#14完了後): WIFに移行し、このキーを廃止
GCP_CREDENTIALS_PATH=/root/.config/gcloud/adc.json
# Vertex AI リージョン（東京）
VERTEX_AI_LOCATION=asia-northeast1
