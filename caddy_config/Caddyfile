{
    email {$SSL_EMAIL}
    servers {
        trusted_proxies static {$TRUSTED_PROXIES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

{$SUBDOMAIN}.{$DOMAIN_NAME} {
    # IP制限（環境変数が設定されている場合のみ有効）
    @blocked_ip {
        expression "{$ALLOWED_IPS}" != ""
        not client_ip {$ALLOWED_IPS:0.0.0.0/0 ::/0}
    }
    respond @blocked_ip 403

    # Basic認証（環境変数が設定されている場合のみ有効）
    @needs_auth {
        expression "{$BASIC_AUTH_USER}" != "" && "{$BASIC_AUTH_PASSWORD_HASH}" != ""
    }
    basic_auth @needs_auth {
        # Default to a non-meaningful placeholder hash so no weak credential is embedded.
        {$BASIC_AUTH_USER:dummy} {$BASIC_AUTH_PASSWORD_HASH:$2a$14$abcdefghijklmnopqrstuuABCDEFGHIJKLMNOPQRSTUVWXabcdefg}
    }

    # すべてのリクエストをOpenFangにプロキシ
    reverse_proxy openfang:8080 {
        flush_interval -1
    }

    header {
        # セキュリティヘッダー
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS（HTTPS強制、1年間）
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # CSP（OpenFang Web UI動作に必要な設定）
        # NOTE: 'unsafe-inline' and 'unsafe-eval' are required for OpenFang's Web UI functionality
        # TODO: 動作確認後にCSPを絞る
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
        -Server
    }

    encode gzip
}
